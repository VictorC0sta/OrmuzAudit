FROM python:3.12-slim

WORKDIR /app

# Avisa ao Python para procurar módulos dentro da pasta shared também
ENV PYTHONPATH="/app/shared"

# 1. Copia a pasta shared
COPY shared/ ./shared/
# 2. Copia a pasta config
COPY config/ ./config/

# 3. Instala as dependências
COPY fabric/connection-profile.json ./fabric/connection-profile.json

# 4. Copia TODOS os arquivos da pasta setor
COPY setor/ .

# 5. Inicia o broker
CMD ["python", "broker_setor.py"]