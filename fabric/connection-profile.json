{
  "name": "ormuz-network",
  "version": "1.0.0",
  "client": {
    "organization": "OrgNorte",
    "credentialStore": {
      "path": "/app/monitor/credentialStore",
      "cryptoStore": {
        "path": "/app/monitor/credentialStore"
      }
    },
    "connection": {
      "timeout": {
        "peer": { "endorser": "300" },
        "orderer": "300"
      }
    }
  },
  "channels": {
    "ormuz-channel": {
      "orderers": [
        "orderer1.ormuz.com",
        "orderer2.ormuz.com",
        "orderer3.ormuz.com"
      ],
      "peers": {
        "peer0.norte.ormuz.com": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        },
        "peer0.sul.ormuz.com": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": false
        },
        "peer0.leste.ormuz.com": {
          "endorsingPeer": true,
          "chaincodeQuery": false,
          "ledgerQuery": false,
          "eventSource": false
        },
        "peer0.oeste.ormuz.com": {
          "endorsingPeer": true,
          "chaincodeQuery": false,
          "ledgerQuery": false,
          "eventSource": false
        }
      }
    }
  },
  "organizations": {
    "OrgNorte": {
      "mspid": "OrgNorteMSP",
      "domain": "norte.ormuz.com",
      "cryptoPath": "/app/fabric/crypto-config/peerOrganizations/norte.ormuz.com",
      "peers": ["peer0.norte.ormuz.com"]
    },
    "OrgSul": {
      "mspid": "OrgSulMSP",
      "domain": "sul.ormuz.com",
      "cryptoPath": "/app/fabric/crypto-config/peerOrganizations/sul.ormuz.com",
      "peers": ["peer0.sul.ormuz.com"]
    },
    "OrgLeste": {
      "mspid": "OrgLesteMSP",
      "domain": "leste.ormuz.com",
      "cryptoPath": "/app/fabric/crypto-config/peerOrganizations/leste.ormuz.com",
      "peers": ["peer0.leste.ormuz.com"]
    },
    "OrgOeste": {
      "mspid": "OrgOesteMSP",
      "domain": "oeste.ormuz.com",
      "cryptoPath": "/app/fabric/crypto-config/peerOrganizations/oeste.ormuz.com",
      "peers": ["peer0.oeste.ormuz.com"]
    }
  },
  "orderers": {
    "orderer1.ormuz.com": {
      "url": "grpcs://orderer1.ormuz.com:7050",
      "tlsCACerts": {
        "path": "/app/fabric/crypto-config/ordererOrganizations/ormuz.com/orderers/orderer1.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "grpc.ssl_target_name_override": "orderer1.ormuz.com",
        "grpc-max-send-message-length": -1
      }
    },
    "orderer2.ormuz.com": {
      "url": "grpcs://orderer2.ormuz.com:8050",
      "tlsCACerts": {
        "path": "/app/fabric/crypto-config/ordererOrganizations/ormuz.com/orderers/orderer2.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "grpc.ssl_target_name_override": "orderer2.ormuz.com",
        "grpc-max-send-message-length": -1
      }
    },
    "orderer3.ormuz.com": {
      "url": "grpcs://orderer3.ormuz.com:9050",
      "tlsCACerts": {
        "path": "/app/fabric/crypto-config/ordererOrganizations/ormuz.com/orderers/orderer3.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "grpc.ssl_target_name_override": "orderer3.ormuz.com",
        "grpc-max-send-message-length": -1
      }
    }
  },
  "peers": {
    "peer0.norte.ormuz.com": {
      "url": "grpcs://peer0.norte.ormuz.com:7051",
      "tlsCACerts": {
        "path": "/app/fabric/crypto-config/peerOrganizations/norte.ormuz.com/peers/peer0.norte.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "grpc.ssl_target_name_override": "peer0.norte.ormuz.com",
        "grpc.keepalive_time_ms": 600000
      }
    },
    "peer0.sul.ormuz.com": {
      "url": "grpcs://peer0.sul.ormuz.com:8051",
      "tlsCACerts": {
        "path": "/app/fabric/crypto-config/peerOrganizations/sul.ormuz.com/peers/peer0.sul.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "grpc.ssl_target_name_override": "peer0.sul.ormuz.com",
        "grpc.keepalive_time_ms": 600000
      }
    },
    "peer0.leste.ormuz.com": {
      "url": "grpcs://peer0.leste.ormuz.com:9051",
      "tlsCACerts": {
        "path": "/app/fabric/crypto-config/peerOrganizations/leste.ormuz.com/peers/peer0.leste.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "grpc.ssl_target_name_override": "peer0.leste.ormuz.com",
        "grpc.keepalive_time_ms": 600000
      }
    },
    "peer0.oeste.ormuz.com": {
      "url": "grpcs://peer0.oeste.ormuz.com:10051",
      "tlsCACerts": {
        "path": "/app/fabric/crypto-config/peerOrganizations/oeste.ormuz.com/peers/peer0.oeste.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "grpc.ssl_target_name_override": "peer0.oeste.ormuz.com",
        "grpc.keepalive_time_ms": 600000
      }
    }
  },
  "certificateAuthorities": {}
}