{
  "name": "ormuz-network",
  "version": "1.0.0",

  "client": {
    "organization": "OrgNorte",
    "connection": {
      "timeout": {
        "peer": { "endorser": "300" },
        "orderer": "300"
      }
    }
  },

  "channels": {
    "ormuz-channel": {
      "orderers": [
        "orderer1.ormuz.com",
        "orderer2.ormuz.com",
        "orderer3.ormuz.com"
      ],
      "peers": {
        "peer0.norte.ormuz.com": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        },
        "peer0.sul.ormuz.com": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": false
        },
        "peer0.leste.ormuz.com": {
          "endorsingPeer": true,
          "chaincodeQuery": false,
          "ledgerQuery": false,
          "eventSource": false
        },
        "peer0.oeste.ormuz.com": {
          "endorsingPeer": true,
          "chaincodeQuery": false,
          "ledgerQuery": false,
          "eventSource": false
        }
      }
    }
  },

  "organizations": {
    "OrgNorte": {
      "mspid": "OrgNorteMSP",
      "peers": ["peer0.norte.ormuz.com"],
      "certificateAuthorities": []
    },
    "OrgSul": {
      "mspid": "OrgSulMSP",
      "peers": ["peer0.sul.ormuz.com"],
      "certificateAuthorities": []
    },
    "OrgLeste": {
      "mspid": "OrgLesteMSP",
      "peers": ["peer0.leste.ormuz.com"],
      "certificateAuthorities": []
    },
    "OrgOeste": {
      "mspid": "OrgOesteMSP",
      "peers": ["peer0.oeste.ormuz.com"],
      "certificateAuthorities": []
    }
  },

  "orderers": {
    "orderer1.ormuz.com": {
      "url": "grpcs://orderer1.ormuz.com:7050",
      "tlsCACerts": {
        "path": "crypto-config/ordererOrganizations/ormuz.com/orderers/orderer1.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "ssl-target-name-override": "orderer1.ormuz.com",
        "grpc-max-send-message-length": -1
      }
    },
    "orderer2.ormuz.com": {
      "url": "grpcs://orderer2.ormuz.com:8050",
      "tlsCACerts": {
        "path": "crypto-config/ordererOrganizations/ormuz.com/orderers/orderer2.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "ssl-target-name-override": "orderer2.ormuz.com",
        "grpc-max-send-message-length": -1
      }
    },
    "orderer3.ormuz.com": {
      "url": "grpcs://orderer3.ormuz.com:9050",
      "tlsCACerts": {
        "path": "crypto-config/ordererOrganizations/ormuz.com/orderers/orderer3.ormuz.com/tls/ca.crt"
      },
      "grpcOptions": {
        "ssl-target-name-override": "orderer3.ormuz.com",
        "grpc-max-send-message-length": -1
      }
    }
  },

  "peers": {
    "peer0.norte.ormuz.com": {
      "url": "grpc://peer0.norte.ormuz.com:7051",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.norte.ormuz.com",
        "grpc.keepalive_time_ms": 600000
      }
    },
    "peer0.sul.ormuz.com": {
      "url": "grpc://peer0.sul.ormuz.com:8051",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.sul.ormuz.com",
        "grpc.keepalive_time_ms": 600000
      }
    },
    "peer0.leste.ormuz.com": {
      "url": "grpc://peer0.leste.ormuz.com:9051",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.leste.ormuz.com",
        "grpc.keepalive_time_ms": 600000
      }
    },
    "peer0.oeste.ormuz.com": {
      "url": "grpc://peer0.oeste.ormuz.com:10051",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.oeste.ormuz.com",
        "grpc.keepalive_time_ms": 600000
      }
    }
  }
}